    "Verifica che l'app possa aprire una connessione TCP alla porta EC del server aMule.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحقق من قدرة التطبيق على فتح اتصال TCP بمنفذ EC لخادم aMule."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft, ob die App eine TCP-Verbindung zum EC-Port des aMule-Servers öffnen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks that the app can open a TCP connection to the aMule server's EC port."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que la app pueda abrir una conexión TCP al puerto EC del servidor aMule."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie que l'app peut ouvrir une connexion TCP vers le port EC du serveur aMule."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查应用能否通过 TCP 连接 aMule 服务器的 EC 端口。"
          }
        }
      }
    },
    "Verifica se un eventuale webserver aMule (amuleweb) risponde all'indirizzo indicato, via HTTPS o HTTP.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحقق مما إذا كان خادم ويب aMule (amuleweb) يستجيب على العنوان المحدد عبر HTTPS أو HTTP."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft, ob ein aMule-Webserver (amuleweb) unter der angegebenen Adresse per HTTPS oder HTTP antwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks whether an aMule web server (amuleweb) responds at the given address, via HTTPS or HTTP."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba si un servidor web de aMule (amuleweb) responde en la dirección indicada, por HTTPS o HTTP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie si un serveur web aMule (amuleweb) répond à l'adresse indiquée, en HTTPS ou HTTP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查 aMule 网页服务器（amuleweb）是否在指定地址响应（HTTPS 或 HTTP）。"
          }
        }
      }
    },
