    "Impossibile connettersi a %@. Controlla che amuled sia acceso e raggiungibile.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن الاتصال بـ %@. تحقق من أن amuled يعمل ويمكن الوصول إليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung zu %@ nicht möglich. Prüfe, ob amuled läuft und erreichbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot connect to %@. Check that amuled is running and reachable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar con %@. Comprueba que amuled esté encendido y accesible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de se connecter à %@. Vérifiez qu'amuled est allumé et joignable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到 %@。请检查 amuled 是否已启动并可访问。"
          }
        }
      }
    },
