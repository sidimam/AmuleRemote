    "Download %@, upload %@. eD2k %@, Kad %@. %lld file in coda, %lld in scaricamento.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التنزيل %1$@، الرفع %2$@. eD2k %3$@، Kad %4$@. %5$lld ملفات في القائمة، %6$lld قيد التنزيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Download %1$@, Upload %2$@. eD2k %3$@, Kad %4$@. %5$lld Dateien in der Warteschlange, %6$lld werden geladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download %1$@, upload %2$@. eD2k %3$@, Kad %4$@. %5$lld files queued, %6$lld downloading."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga %1$@, subida %2$@. eD2k %3$@, Kad %4$@. %5$lld archivos en cola, %6$lld descargando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargement %1$@, envoi %2$@. eD2k %3$@, Kad %4$@. %5$lld fichiers en file, %6$lld en cours."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载 %1$@，上传 %2$@。eD2k %3$@，Kad %4$@。%5$lld 个文件排队，%6$lld 个下载中。"
          }
        }
      }
    },
