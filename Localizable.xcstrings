            "state": "translated",
            "value": "Banned clients"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clientes bloqueados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clients bannis"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已封禁的客户端"
          }
        }
      }
    },
    "Coda dei download con avanzamento, velocità, fonti e tempo stimato; pausa, riprendi, ferma, priorità, categorie ed eliminazione anche in selezione multipla. Ricerca locale e globale a schede, con i risultati già in coda in rosso e quelli già scaricati in verde.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قائمة التنزيلات مع التقدم والسرعة والمصادر والوقت المتبقي؛ إيقاف مؤقت واستئناف وإيقاف وأولوية وفئات وحذف، حتى في التحديد المتعدد. بحث محلي وعالمي بعلامات تبويب، مع النتائج الموجودة في القائمة بالأحمر والمنزّلة سابقًا بالأخضر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Download-Warteschlange mit Fortschritt, Geschwindigkeit, Quellen und Restzeit; Pause, Fortsetzen, Stopp, Priorität, Kategorien und Löschen, auch in Mehrfachauswahl. Lokale und globale Suche in Tabs, bereits eingereihte Ergebnisse rot, bereits geladene grün."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download queue with progress, speed, sources and ETA; pause, resume, stop, priority, categories and delete, also in multi-selection. Tabbed local and global search, with results already queued in red and already downloaded in green."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cola de descargas con avance, velocidad, fuentes y tiempo estimado; pausar, reanudar, detener, prioridad, categorías y eliminar, también en selección múltiple. Búsqueda local y global por pestañas, con los resultados ya en cola en rojo y los ya descargados en verde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "File des téléchargements avec avancement, vitesse, sources et temps estimé ; pause, reprise, arrêt, priorité, catégories et suppression, aussi en sélection multiple. Recherche locale et globale à onglets, avec les résultats déjà en file en rouge et ceux déjà téléchargés en vert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载队列显示进度、速度、来源和预计时间；可暂停、继续、停止、设定优先级、分类和删除，也支持多选。标签式本地和全局搜索，已在队列中的结果显示为红色，已下载的显示为绿色。"
          }
        }
      }
    },
