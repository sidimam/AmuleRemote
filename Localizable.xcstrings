    "Avvia una ricerca sul server aMule e restituisce i nomi dei primi risultati (attende fino a 15 secondi).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ بحثًا على خادم aMule ويُعيد أسماء النتائج الأولى (ينتظر حتى 15 ثانية)."
          }
        },
        "de": {
          "stringUnit": {
