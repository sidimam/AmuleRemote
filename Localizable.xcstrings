{
  "sourceLanguage": "it",
  "strings": {
    "%@ non è più connesso alla rete Kad.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ لم يعد متصلاً بشبكة Kad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht mehr mit dem Kad-Netzwerk verbunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is no longer connected to the Kad network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya no está conectado a la red Kad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'est plus connecté au réseau Kad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已断开 Kad 网络连接。"
          }
        }
      }
    },
    "%@ non è più connesso alla rete eD2k.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ لم يعد متصلاً بشبكة eD2k."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht mehr mit dem eD2k-Netzwerk verbunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is no longer connected to the eD2k network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya no está conectado a la red eD2k."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'est plus connecté au réseau eD2k."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已断开 eD2k 网络连接。"
          }
        }
      }
    },
    "%@ risponde di nuovo.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ يستجيب من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ antwortet wieder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is responding again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vuelve a responder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ répond de nouveau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已恢复响应。"
          }
        }
      }
    },
    "%@ è di nuovo connesso alla rete Kad.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ متصل من جديد بشبكة Kad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist wieder mit dem Kad-Netzwerk verbunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is connected to the Kad network again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vuelve a estar conectado a la red Kad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est de nouveau connecté au réseau Kad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已重新连接到 Kad 网络。"
          }
        }
      }
    },
