    "Connette a un server qualsiasi scelto da aMule. Per un server preciso, fai doppio clic sul server nella lista.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتصل بأي خادم يختاره aMule. لخادم محدد، انقر عليه مرتين في القائمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindet mit einem von aMule gewählten Server. Für einen bestimmten Server doppelklicken Sie ihn in der Liste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connects to any server chosen by aMule. For a specific server, double-click it in the list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta a un servidor cualquiera elegido por aMule. Para un servidor concreto, haz doble clic en la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecte à un serveur choisi par aMule. Pour un serveur précis, double-cliquez dessus dans la liste."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 aMule 自选的服务器。要连接特定服务器，请在列表中双击它。"
          }
        }
      }
    },
