    },
    "Disconnetti dopo inattività": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قطع الاتصال بعد الخمول"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Inaktivität trennen"
          }
        },
        "en": {
          "stringUnit": {
