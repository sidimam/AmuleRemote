      }
    },
    "Accoda uno o più link ed2k:// sul server aMule (anche un testo che li contiene).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف رابطًا واحدًا أو أكثر من روابط ed2k:// إلى قائمة خادم aMule (أو نصًا يحتويها)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiht einen oder mehrere ed2k://-Links auf dem aMule-Server ein (auch ein Text, der sie enthält)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queues one or more ed2k:// links on the aMule server (any text containing them works too)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encola uno o varios enlaces ed2k:// en el servidor aMule (también un texto que los contenga)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met en file un ou plusieurs liens ed2k:// sur le serveur aMule (un texte qui les contient convient aussi)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将一个或多个 ed2k:// 链接加入 aMule 服务器队列（也可传入包含链接的文本）。"
          }
        }
      }
    },
