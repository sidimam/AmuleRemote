    "%@. Software libero con licenza MIT. Il protocollo EC (External Connections) appartiene al progetto aMule.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. برنامج حر بترخيص MIT. بروتوكول EC (External Connections) يعود إلى مشروع aMule."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Freie Software unter MIT-Lizenz. Das EC-Protokoll (External Connections) gehört dem aMule-Projekt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Free software under the MIT License. The EC (External Connections) protocol belongs to the aMule project."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Software libre con licencia MIT. El protocolo EC (External Connections) pertenece al proyecto aMule."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Logiciel libre sous licence MIT. Le protocole EC (External Connections) appartient au projet aMule."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。基于 MIT 许可证的自由软件。EC（External Connections）协议归 aMule 项目所有。"
          }
        }
      }
    },
