          "stringUnit": {
            "state": "translated",
            "value": "在 iCloud 上找到 %lld 个服务器配置。"
          }
        }
      }
    },
    "Trovato un backup con %lld profili server (ultimo aggiornamento %@). Vuoi ripristinarlo su questo dispositivo?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم العثور على نسخة احتياطية تحتوي على %lld من ملفات تعريف الخادم (آخر تحديث %@). هل تريد استعادتها على هذا الجهاز؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup mit %lld Serverprofilen gefunden (letzte Aktualisierung %@). Auf diesem Gerät wiederherstellen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found a backup with %lld server profiles (last updated %@). Restore it on this device?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha encontrado una copia con %lld perfiles de servidor (última actualización %@). ¿Restaurarla en este dispositivo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sauvegarde avec %lld profils de serveur a été trouvée (dernière mise à jour %@). La restaurer sur cet appareil ?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找到包含 %lld 个服务器配置的备份（最后更新 %@）。要在此设备上恢复吗？"
          }
        }
      }
    },
    "Trovato un backup con %lld profili server. Vuoi ripristinarlo su questo dispositivo?": {
      "localizations": {
        "ar": {
          "stringUnit": {
