    "Corrispondono a MaxConnectionsPerFiveSeconds, FileBufferSizePref, QueueSizePref e ServerKeepAliveTimeout in amule.conf. Modificali solo se sai cosa fai.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقابل MaxConnectionsPerFiveSeconds وFileBufferSizePref وQueueSizePref وServerKeepAliveTimeout في amule.conf. لا تغيّرها إلا إذا كنت تعرف ما تفعل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie entsprechen MaxConnectionsPerFiveSeconds, FileBufferSizePref, QueueSizePref und ServerKeepAliveTimeout in amule.conf. Nur ändern, wenn Sie wissen, was Sie tun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They map to MaxConnectionsPerFiveSeconds, FileBufferSizePref, QueueSizePref and ServerKeepAliveTimeout in amule.conf. Change them only if you know what you are doing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corresponden a MaxConnectionsPerFiveSeconds, FileBufferSizePref, QueueSizePref y ServerKeepAliveTimeout en amule.conf. Modifícalos solo si sabes lo que haces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils correspondent à MaxConnectionsPerFiveSeconds, FileBufferSizePref, QueueSizePref et ServerKeepAliveTimeout dans amule.conf. Ne les modifiez que si vous savez ce que vous faites."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对应 amule.conf 中的 MaxConnectionsPerFiveSeconds、FileBufferSizePref、QueueSizePref 和 ServerKeepAliveTimeout。仅在了解其含义时修改。"
          }
        }
      }
    },
