    "Scrivi il testo nella barra di ricerca e premi Cerca. I risultati già in download sono in rosso, quelli già scaricati in verde.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب النص في شريط البحث واضغط بحث. النتائج التي يجري تنزيلها تظهر بالأحمر، والملفات المنزّلة سابقًا بالأخضر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den Text in die Suchleiste ein und drücke Suchen. Bereits laufende Downloads erscheinen rot, bereits heruntergeladene Dateien grün."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type in the search bar and press Search. Results already downloading are shown in red, files you already downloaded in green."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe en la barra de búsqueda y pulsa Buscar. Los resultados ya en descarga aparecen en rojo, los ya descargados en verde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le texte dans la barre de recherche et appuyez sur Rechercher. Les résultats déjà en téléchargement sont en rouge, ceux déjà téléchargés en vert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在搜索栏输入文字并按“搜索”。正在下载的结果显示为红色，已下载的显示为绿色。"
          }
        }
      }
    },
    "Scuro": {
