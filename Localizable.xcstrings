          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts a search on the aMule server and returns the names of the first results (waits up to 15 seconds)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una búsqueda en el servidor aMule y devuelve los nombres de los primeros resultados (espera hasta 15 segundos)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
